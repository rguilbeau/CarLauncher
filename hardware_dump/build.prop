#
# from device/sprd/sharkl5Pro/uis7862s_1h10/system.prop
#
# Default density config
#ro.sf.lcd_density=320
#ro.sf.lcd_width=54
#ro.sf.lcd_height=96
ro.product.hardware=uis7862s_1h10
ro.vendor.audio.product.hardware=uis7862s_1h10
# Set Opengl ES Version
#ro.opengles.version=196609

# ro.fm.chip.port.UART.androidm=true

# FRP property for pst device
ro.frp.pst=/dev/block/platform/soc/soc:ap-apb/71400000.sdio/by-name/persist

#enable audio nr tuning
ro.vendor.audio_tunning.nr=1

#hp to spk audio tunning
ro.vendor.audio_tunning.dual_spk=2

#config dreamcamera begin
persist.sys.cam.battery.flash = 10
persist.sys.cam.3dnr=true
persist.sys.cam.normalhdr=false
persist.sys.cam.beauty.fullfuc=false
persist.sys.cam.sfv.alter=true
persist.sys.cam.filter.version=2
#config dreamcamera end

#Enable sdcardfs feature
ro.sys.sdcardfs=true
persist.sys.sdcardfs=force_on

persist.sys.cam.ba.blur.version=6
persist.sys.cam.api.version=0
persist.sys.blending.enable=true
persist.sys.sprd.refocus.bokeh=true

persist.sys.cam.fr.blur.version=1
#eis function
persist.sys.cam.eois.dc.back=false
persist.sys.cam.eois.dc.front=false
persist.sys.cam.eois.dv.back=true
persist.sys.cam.eois.dv.front=false

#enable 3d calibration
persist.sys.3d.calibraion=1
persist.sys.cam3.type=back_bokeh
persist.sys.cam3.multi.cam.id=2

#config lmkd parameters
ro.lmk.use_psi=true
ro.lmk.use_minfree_levels=true

#add for performance
ro.lmk.vmpressurenhanced=true
sys.rotation.animscale=0.5
persist.sys.cam.fast.blur=true

#enable CONFIG_IVI_FEATURE
persist.ivi.feature=1

#Enable virtualkeys
qemu.hw.mainkeys=0

#use audio whale hal
ro.audio.whale_hal=true

#audio offload wakelock
ro.audio.offload_wakelock=0

#add for lowpower vowifi
persist.dbg.lowpower_vowifi=0

#qf patch, enable wireless adb port, by liuhualiang
service.adb.tcp.port=9876

#qf patch, set gps mode to GPS+BD, by liuhualiang
ro.ge2.mode=gps_beidou

#enable txz echo cancellation
persist.sys.qf.txz.ace.enable=false

#qf patch, set default timezone
persist.sys.timezone=Asia/Shanghai

#for audio index test, by liuhualiang
persist.sys.fm.max.volume=9
persist.sys.music.gain=-3

#for camera ID, by zxj
#persist.vendor.cam.id=0

#adjust logcat buffer, fix logcat EOF bug
persist.logd.size 16777216
# end of device/sprd/sharkl5Pro/uis7862s_1h10/system.prop

