<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_20sdp"
    android:paddingTop="@dimen/_45sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingBottom="@dimen/_10sdp">

    <!-- COLONNE GAUCHE -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_weight="1.3"
        android:orientation="vertical">

        <com.rguilbeau.carlauncher.component.CardWeather
            android:layout_width="match_parent"
            android:layout_height="@dimen/_90sdp"
            android:layout_marginBottom="@dimen/_10sdp" />

        <com.rguilbeau.carlauncher.component.CardMusic
            android:layout_width="match_parent"
            android:layout_height="@dimen/_88sdp"
            android:layout_marginBottom="@dimen/_10sdp" />

        <com.rguilbeau.carlauncher.component.CardMaps
            android:layout_width="match_parent"
            android:layout_height="@dimen/_39sdp"
            app:type="navigation" />
    </LinearLayout>

    <!-- COLONNE DROITE -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_10sdp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.rguilbeau.carlauncher.component.CardSpeed
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_weight="1" />

            <com.rguilbeau.carlauncher.component.CardTrip
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_weight="1" />
        </LinearLayout>

        <com.rguilbeau.carlauncher.component.CardButton
            android:layout_width="match_parent"
            android:layout_height="@dimen/_39sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            app:cardColor="#329163"
            app:cardDescription="Lancement du téléphone"
            app:cardIcon="@drawable/ic_button_phone"
            app:cardTitle="Téléphone"
            app:type="phone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.rguilbeau.carlauncher.component.CardButton
                android:layout_weight="2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_39sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                app:cardColor="#00505B"
                app:cardDescription="Luminosité +/−"
                app:cardIcon="@drawable/ic_button_day_night"
                app:cardTitle="Jour/Nuit"
                app:type="day_night" />

            <com.rguilbeau.carlauncher.component.CardButton
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_39sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                app:cardColor="#263038"
                app:cardDescription=""
                app:cardIcon="@drawable/ic_button_settings"
                app:cardTitle="App"
                app:type="settings"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.rguilbeau.carlauncher.component.CardButton
                android:layout_weight="2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_39sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                app:cardColor="#502A87"
                app:cardDescription="Air conditionné"
                app:cardIcon="@drawable/ic_button_clim"
                app:cardTitle="Clim"
                app:type="clim_popup" />

            <com.rguilbeau.carlauncher.component.CardButton
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_39sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                app:cardColor="#5C7182"
                app:cardDescription=""
                app:cardIcon="@drawable/ic_button_apps"
                app:cardTitle="App"
                app:type="run_activity"
                app:cardActivityName="com.rguilbeau.carlauncher.activity.AppDrawerActivity"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>