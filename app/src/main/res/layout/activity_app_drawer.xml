<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#040202"
    android:paddingTop="@dimen/_35sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingBottom="@dimen/_10sdp"
    android:orientation="horizontal">

    <!-- Barre latérale gauche -->
    <LinearLayout
        android:layout_width="@dimen/_40sdp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Bouton retour (En haut) -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_button_gloab_back" />

        <!-- Espace flexible pour repousser le bouton suivant vers le bas -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bouton mise à jour (En bas) -->
        <ImageView
            android:id="@+id/btnUpdate"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/_12sdp"
            android:src="@drawable/ic_button_update" />

    </LinearLayout>

    <!-- La grille des applications (prend tout l'espace restant) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp" />

</LinearLayout>