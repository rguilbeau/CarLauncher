<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="#014950"
    app:cardCornerRadius="@dimen/_15sdp"
    android:foreground="@drawable/overlay_card_pressed"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Titre (équivalent au mot "Vitesse") -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3BCC8"
            android:textSize="@dimen/_12sdp"
            android:text="Aujourd'hui" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTripDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_24sdp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:text="365" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3BCC8"
                android:textSize="@dimen/_15sdp"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:text="km" />
        </LinearLayout>
        <!-- Unité et Temps en petit (équivalent au "km/h") -->
        <TextView
            android:id="@+id/txtTripTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11sdp"
            android:textColor="#B3BCC8"
            android:text="0 min" />

    </LinearLayout>

</androidx.cardview.widget.CardView>